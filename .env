# Local secrets. This file is git-ignored and must stay that way.
#
# Everything here is read automatically:
#   backend (bun/tsx)   -> backend/src/config/env.ts reads backend/.env, then
#                          falls back to this file (repo root)
#   docker compose up   -> compose reads .env from this directory
#
# Rotate anything that has ever been pasted into a chat, an issue or a commit.
# These Mailjet + SendGrid keys were borrowed from the Fraud Detection
# project's own .env, for testing only, at your instruction.

# Shared
TZ=Asia/Kolkata

# TimescaleDB
POSTGRES_DB=invexa
POSTGRES_USER=invexa
POSTGRES_PASSWORD=invexa_password
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Kafka
KAFKA_EXTERNAL_PORT=9094

# Backend app
BACKEND_PORT=3000
DATABASE_URL=postgres://invexa:invexa_password@localhost:5432/invexa
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9094
KAFKA_CLIENT_ID=invexa-backend
CORS_ORIGIN=http://localhost:5173
SIM_CONTROL_TOPIC=sim-control
PRICE_TICKS_TOPIC=price-ticks
ORDERS_PLACED_TOPIC=orders-placed
ORDERS_FILLED_TOPIC=orders-filled
COMPETITION_EVENTS_TOPIC=competition-events

# --- Mailjet -----------------------------------------------------------------
# Both are needed; they are used together as basic auth.
# Account settings -> REST API -> Master API Key & Sub API key management.
MAILJET_API_KEY=d6ef8635d156aa890297158072eef34f
MAILJET_SECRET_KEY=9e074ef14c4a9d7c16ffad16c64ed726

# Must be an address you have verified with Mailjet
# (Account settings -> Senders & Domains -> Add a sender).
MAIL_FROM=Invexa <robinvon6@gmail.com>

# --- SendGrid (fallback if Mailjet fails or isn't configured) ----------------
SENDGRID_API_KEY=SG.xq8tAI9gS0qyChnSUq9tAA.MtKS8MC_pg9_gq4f3GgAUbvYNKc_9xi0L9uqgTDn0sQ

# Alerts about money moving. 0 silences them while testing by hand.
NOTIFY_BY_EMAIL=1

# Keeps sessions valid across restarts. Any string of 32+ characters.
JWT_SECRET=f3d60e5d641fa901d8feccc81365078cde84774d1b2617b0856c43592579ba77

# Frontend
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws/prices

# Python sim
SIM_TICK_INTERVAL=1.0
SIM_TICKERS=FAKE,TSIM,NOVA,ALFA,ZENX
SIM_START_PRICE=100.0
SIM_STRATEGY=random_walk
SIM_VOLATILITY=0.02
SIM_DRIFT=0.0005
SIM_MEAN_REVERSION_STRENGTH=0.08
SIM_CIRCUIT_LIMIT=0.03
SIM_KAFKA_BROKERS=localhost:9094
SIM_PRICE_TOPIC=price-ticks
SIM_CONTROL_TOPIC=sim-control
