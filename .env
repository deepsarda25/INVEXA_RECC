# Local dev secrets — gitignored, never committed. Copied from .env.example.
# Fill in the SMTP_* block below to turn on mail (signup OTP, the welcome/
# credentials email, and trade-fill notifications). Leave it blank and
# everything else keeps working — mail is just skipped, with a one-time log
# line saying so.

# Shared
TZ=Asia/Kolkata

# TimescaleDB
POSTGRES_DB=invexa
POSTGRES_USER=invexa
POSTGRES_PASSWORD=invexa_password
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Kafka
KAFKA_EXTERNAL_PORT=9094

# Backend app
BACKEND_PORT=3000
JWT_SECRET=f3d60e5d641fa901d8feccc81365078cde84774d1b2617b0856c43592579ba77
DATABASE_URL=postgres://invexa:invexa_password@localhost:5432/invexa
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9094
KAFKA_CLIENT_ID=invexa-backend
CORS_ORIGIN=http://localhost:5173
SIM_CONTROL_TOPIC=sim-control
PRICE_TICKS_TOPIC=price-ticks
ORDERS_PLACED_TOPIC=orders-placed
ORDERS_FILLED_TOPIC=orders-filled
COMPETITION_EVENTS_TOPIC=competition-events

# Mail — Mailjet is tried first, then SendGrid, then SMTP (unset below).
# These Mailjet + SendGrid keys are borrowed from the Fraud Detection
# project's own .env, for testing only, at your instruction — rotate them
# (or swap in your own) before this goes anywhere real. MAIL_FROM's address
# is whatever sender is verified against these keys; only the display name
# was changed to Invexa.
MAILJET_API_KEY=d6ef8635d156aa890297158072eef34f
MAILJET_SECRET_KEY=9e074ef14c4a9d7c16ffad16c64ed726
SENDGRID_API_KEY=SG.xq8tAI9gS0qyChnSUq9tAA.MtKS8MC_pg9_gq4f3GgAUbvYNKc_9xi0L9uqgTDn0sQ

# Plain SMTP fallback — leave unset while Mailjet/SendGrid above are in use.
# Easiest option if you ever do want it: Gmail with an App password (needs
# 2-Step Verification turned on for the Google account first):
#   1. https://myaccount.google.com/apppasswords
#   2. Create an app password named e.g. "Invexa", copy the 16 characters
#      it gives you (spaces don't matter).
#   3. SMTP_USER is the full Gmail address; SMTP_PASS is that app password
#      (NOT the normal Gmail account password — that will not work).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Invexa <robinvon6@gmail.com>

# Frontend
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws/prices

# Python sim
SIM_TICK_INTERVAL=1.0
SIM_TICKERS=FAKE,TSIM,NOVA,ALFA,ZENX
SIM_START_PRICE=100.0
SIM_STRATEGY=random_walk
SIM_VOLATILITY=0.02
SIM_DRIFT=0.0005
SIM_MEAN_REVERSION_STRENGTH=0.08
SIM_CIRCUIT_LIMIT=0.03
SIM_KAFKA_BROKERS=localhost:9094
SIM_PRICE_TOPIC=price-ticks
SIM_CONTROL_TOPIC=sim-control
