# Shared
TZ=Asia/Kolkata

# TimescaleDB
POSTGRES_DB=invexa
POSTGRES_USER=invexa
POSTGRES_PASSWORD=invexa_password
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Kafka
KAFKA_EXTERNAL_PORT=9094

# Backend app
BACKEND_PORT=3000
JWT_SECRET=replace_with_a_long_random_secret
DATABASE_URL=postgres://invexa:invexa_password@localhost:5432/invexa
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9094
KAFKA_CLIENT_ID=invexa-backend
CORS_ORIGIN=http://localhost:5173
SIM_CONTROL_TOPIC=sim-control
PRICE_TICKS_TOPIC=price-ticks
ORDERS_PLACED_TOPIC=orders-placed
ORDERS_FILLED_TOPIC=orders-filled
COMPETITION_EVENTS_TOPIC=competition-events

# Mail (transactional email: signup verification OTP, welcome/credentials
# email, and trade-fill notifications). Leave all of this unset and the app
# runs fine — sending is just skipped, logged once at startup.
#
# Three providers are tried in order, each only if it's configured, and a
# provider that errors falls through to the next rather than losing the
# email: Mailjet, then SendGrid, then plain SMTP. You only need to set up
# one of them; set up two if you want the fallback.
#
# Mailjet — https://app.mailjet.com -> Account settings -> REST API ->
# Master API Key & Sub API key management. Both keys are required, used
# together as basic auth.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# SendGrid — https://app.sendgrid.com -> Settings -> API Keys.
SENDGRID_API_KEY=

# Plain SMTP fallback. Gmail example: SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=587, SMTP_SECURE=false, SMTP_USER=you@gmail.com, SMTP_PASS=<a
# 16-character Gmail "App password", not your normal Gmail password —
# generate one at https://myaccount.google.com/apppasswords (needs
# 2-Step Verification on). Any other SMTP provider (Mailtrap, Brevo, your
# own mail server, etc.) works the same way — just point these at it.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Must be an address/domain verified with whichever provider(s) above you use.
MAIL_FROM=Invexa <no-reply@invexa.app>

# Frontend
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws/prices

# Python sim
SIM_TICK_INTERVAL=1.0
SIM_TICKERS=FAKE,TSIM,NOVA,ALFA,ZENX
SIM_START_PRICE=100.0
SIM_STRATEGY=random_walk
SIM_VOLATILITY=0.02
SIM_DRIFT=0.0005
SIM_MEAN_REVERSION_STRENGTH=0.08
SIM_CIRCUIT_LIMIT=0.03
SIM_KAFKA_BROKERS=localhost:9094
SIM_PRICE_TOPIC=price-ticks
SIM_CONTROL_TOPIC=sim-control
