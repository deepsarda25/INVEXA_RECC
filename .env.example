# Shared
TZ=Asia/Kolkata

# TimescaleDB
POSTGRES_DB=invexa
POSTGRES_USER=invexa
POSTGRES_PASSWORD=invexa_password
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Kafka
KAFKA_EXTERNAL_PORT=9094

# Backend app
BACKEND_PORT=3000
JWT_SECRET=replace_with_a_long_random_secret
DATABASE_URL=postgres://invexa:invexa_password@localhost:5432/invexa
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9094
KAFKA_CLIENT_ID=invexa-backend
CORS_ORIGIN=http://localhost:5173
SIM_CONTROL_TOPIC=sim-control
PRICE_TICKS_TOPIC=price-ticks
ORDERS_PLACED_TOPIC=orders-placed
ORDERS_FILLED_TOPIC=orders-filled
COMPETITION_EVENTS_TOPIC=competition-events

# Mail (transactional email: signup verification OTP, welcome/credentials
# email, and trade-fill notifications). Leave all of this unset and the app
# runs fine — sending is just skipped, logged once at startup.
#
# Two providers are tried in order, each only if it's configured, and a
# provider that errors falls through to the next rather than losing the
# email: Brevo, then Gmail SMTP. You only need to set up one of them; set
# up both if you want the fallback.
#
# Brevo — https://app.brevo.com -> Settings -> SMTP & API -> API Keys ->
# Generate a new API key. Also verify a sender under Senders & IP ->
# Senders (the address MAIL_FROM below uses) — usually approved within
# minutes, not the days a brand-new Mailjet/domain review can take.
BREVO_API_KEY=

# Must be an address you have verified with Brevo (see above).
MAIL_FROM=Invexa <no-reply@invexa.app>

# Gmail SMTP fallback — the fastest to set up of the two, and not subject
# to a third-party account review at all:
#   1. Turn on 2-Step Verification on the Google account (if not already):
#      https://myaccount.google.com/security
#   2. Generate an App Password: https://myaccount.google.com/apppasswords
#      (name it e.g. "Invexa"), copy the 16 characters it gives you.
#   3. GMAIL_USER is the full Gmail address; GMAIL_APP_PASSWORD is that
#      16-character app password (NOT the normal Gmail account password).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Alerts about money moving. 0 silences them while testing by hand.
NOTIFY_BY_EMAIL=1

# Frontend
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws/prices

# Python sim
SIM_TICK_INTERVAL=1.0
SIM_TICKERS=FAKE,TSIM,NOVA,ALFA,ZENX
SIM_START_PRICE=100.0
SIM_STRATEGY=random_walk
SIM_VOLATILITY=0.02
SIM_DRIFT=0.0005
SIM_MEAN_REVERSION_STRENGTH=0.08
SIM_CIRCUIT_LIMIT=0.03
SIM_KAFKA_BROKERS=localhost:9094
SIM_PRICE_TOPIC=price-ticks
SIM_CONTROL_TOPIC=sim-control
